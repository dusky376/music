<view class="wrap">
  <block wx:if="{{track}}">
    <image class="artwork {{isPlaying ? 'spin' : ''}}" src="{{track.cover}}" mode="aspectFill" />

    <view class="meta">
      <text class="name">{{track.name}}</text>
      <text class="artist">{{track.artist}}</text>
    </view>

    <!-- 歌词在进度条上方；高亮行通过 scroll-into-view 自动滚动跟随 -->
    <scroll-view
      class="lyrics"
      scroll-y
      scroll-into-view="{{lyricInto}}"
      scroll-with-animation
    >
      <view class="lyric-pad"></view>
      <view
        wx:for="{{lyricLines}}"
        wx:key="time"
        id="lyr-{{index}}"
        class="lyric {{index === lyricActive ? 'lyric-active' : ''}}"
      >{{item.text}}</view>
      <view class="lyric-pad"></view>
    </scroll-view>

    <slider
      class="progress"
      min="0"
      max="{{duration || 1}}"
      value="{{current}}"
      activeColor="#007aff"
      backgroundColor="rgba(0,0,0,0.08)"
      block-size="18"
      bindchanging="onSliderChanging"
      bindchange="onSeek"
    />
    <view class="times"><text>{{currText}}</text><text>{{durText}}</text></view>

    <view class="controls">
      <view class="ctl-btn ic-prev" bindtap="onPrev"></view>
      <view class="ctl-btn main {{isPlaying ? 'ic-pause' : 'ic-play'}}" bindtap="onToggle"></view>
      <view class="ctl-btn ic-next" bindtap="onNext"></view>
    </view>
  </block>

  <view wx:else class="empty">从首页选一首歌开始播放</view>
</view>
