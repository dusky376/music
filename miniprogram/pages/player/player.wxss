.wrap {
  padding: 32rpx 32rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 26rpx;
  /* 必须是 height（确定高度），不能是 min-height：
     flex 子项的收/放都以容器确定高度为基础；min-height 下容器会随
     歌词列表的原始高度增长，整页被撑爆导致滚动（每次"歌词变墙"的根因） */
  height: 100vh;
  box-sizing: border-box;
}

/* 进度条+时间+控制键成组；底部不设 auto margin，让歌词卡吃掉全部剩余空间 */
.bottom-block {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 26rpx;
}

.artwork-box {
  position: relative;
  flex: 0 0 auto; /* 封面顶上去：不再用 margin-top:auto 推出顶部空当 */
}

/* 圆形唱片：旋转时不突兀；暂停用 animation-play-state 停在原角度（不会跳回 0°） */
.artwork {
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background: #ececf1;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.16);
  animation: artwork-spin 24s linear infinite;
  animation-play-state: paused;
}

.artwork.spin {
  animation-play-state: running;
}

@keyframes artwork-spin {
  to { transform: rotate(360deg); }
}

/* 唱片中心孔：静态覆盖层，旋转时强化"唱片"观感 */
.disc-hole {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 48rpx;
  height: 48rpx;
  margin-left: -24rpx;
  margin-top: -24rpx;
  border-radius: 50%;
  background: #f7f7f9;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.25), 0 0 0 6rpx rgba(255, 255, 255, 0.22);
  pointer-events: none;
}

/* 音频加载中：把"点了没反应"变成可见的转圈 */
.audio-loading {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.42);
}

.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 5rpx solid rgba(0, 0, 0, 0.12);
  border-top-color: #1d1d1f;
  border-radius: 50%;
  animation: spinner-rot 800ms linear infinite;
}

@keyframes spinner-rot {
  to { transform: rotate(360deg); }
}

.meta {
  text-align: center;
}

.name {
  display: block;
  font-size: 38rpx;
  font-weight: 750;
  letter-spacing: -1rpx;
}

.artist {
  display: block;
  margin-top: 8rpx;
  color: #75757c;
  font-size: 26rpx;
}

.progress-box {
  width: 100%; /* 包裹层必须与 .progress 同宽：防止被 flex 收缩挤压 slider 触摸区 */
}

.progress {
  width: 100%;
}

.times {
  width: 100%;
  display: flex;
  justify-content: space-between;
  color: #75757c;
  font-size: 22rpx;
}

.controls {
  display: flex;
  align-items: center;
  gap: 44rpx;
}

/* 控制按钮：不用 <button>（默认样式洗不干净），不用 emoji（手机端渲染成彩色表情）。
   图标统一用内嵌 SVG data-uri，跨设备渲染一致。 */
.ctl-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 52rpx 52rpx;
}

.ctl-btn:active {
  opacity: 0.6;
}

.ic-prev {
  background-image: url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZD0iTTYgNmgydjEySDZ6bTMuNSA2bDguNSA2VjZ6IiBmaWxsPSIjM2EzYTQwIi8+PC9zdmc+');
