.wrap {
  padding: 40rpx 32rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 26rpx;
}

.artwork {
  width: 460rpx;
  height: 460rpx;
  border-radius: 40rpx;
  background: #ececf1;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.16);
}

.meta {
  text-align: center;
}

.name {
  display: block;
  font-size: 38rpx;
  font-weight: 750;
  letter-spacing: -1rpx;
}

.artist {
  display: block;
  margin-top: 8rpx;
  color: #75757c;
  font-size: 26rpx;
}

.progress {
  width: 100%;
}

.times {
  width: 100%;
  display: flex;
  justify-content: space-between;
  color: #75757c;
  font-size: 22rpx;
}

.controls {
  display: flex;
  align-items: center;
  gap: 40rpx;
}

.ctl-btn {
  border: none;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 50%;
  width: 96rpx;
  height: 96rpx;
  font-size: 34rpx;
  line-height: 96rpx;
  padding: 0;
  color: #1d1d1f;
}

.ctl-btn::after {
  border: none;
}

.ctl-btn.main {
  width: 140rpx;
  height: 140rpx;
  line-height: 140rpx;
  font-size: 48rpx;
  background: #1d1d1f;
  color: #fff;
}

.lyrics {
  width: 100%;
  height: 380rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

.lyric {
  padding: 10rpx 0;
  color: rgba(29, 29, 31, 0.35);
  font-size: 28rpx;
  transition: color 200ms ease;
}

.lyric-active {
  color: #1d1d1f;
  font-weight: 650;
}
