.wrap {
  padding: 40rpx 32rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 26rpx;
}

.artwork {
  width: 460rpx;
  height: 460rpx;
  border-radius: 40rpx;
  background: #ececf1;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.16);
}

.meta {
  text-align: center;
}

.name {
  display: block;
  font-size: 38rpx;
  font-weight: 750;
  letter-spacing: -1rpx;
}

.artist {
  display: block;
  margin-top: 8rpx;
  color: #75757c;
  font-size: 26rpx;
}

.progress {
  width: 100%;
}

.times {
  width: 100%;
  display: flex;
  justify-content: space-between;
  color: #75757c;
  font-size: 22rpx;
}

.controls {
  display: flex;
  align-items: center;
  gap: 56rpx;
}

/* 控制按钮：不用 <button>（默认样式洗不干净），不用 emoji（手机端渲染成彩色表情）。
   图标统一用内嵌 SVG data-uri，跨设备渲染一致。 */
.ctl-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 52rpx 52rpx;
}

.ctl-btn:active {
  opacity: 0.6;
}

.ic-prev {
  background-image: url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZD0iTTYgNmgydjEySDZ6bTMuNSA2bDguNSA2VjZ6IiBmaWxsPSIjM2EzYTQwIi8+PC9zdmc+');
}

.ic-next {
  background-image: url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZD0iTTE2IDZoMnYxMmgtMnpNNiAxOGw4LjUtNkw2IDZ6IiBmaWxsPSIjM2EzYTQwIi8+PC9zdmc+');
}

.ctl-btn.main {
  width: 144rpx;
  height: 144rpx;
  background-color: #1d1d1f;
  background-size: 60rpx 60rpx;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.24);
}

.ic-play {
  background-image: url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZD0iTTggNXYxNGwxMS03eiIgZmlsbD0iI2ZmZmZmZiIvPjwvc3ZnPg==');
}

.ic-pause {
  background-image: url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZD0iTTYgMTloNFY1SDZ6bTgtMTR2MTRoNFY1eiIgZmlsbD0iI2ZmZmZmZiIvPjwvc3ZnPg==');
}

.lyrics {
  width: 100%;
  height: 320rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
}

/* 歌词滚动缓冲：上/下各留半屏高，让第一句/最后一句也能滚到高亮可视位置 */
.lyric-pad {
  height: 96rpx;
}

.lyric {
  padding: 10rpx 0;
  color: rgba(29, 29, 31, 0.35);
  font-size: 28rpx;
  transition: color 200ms ease;
}

.lyric-active {
  color: #1d1d1f;
  font-weight: 650;
}
