}

.ctl-btn.main {
  width: 144rpx;
  height: 144rpx;
  background-color: #1d1d1f;
  background-size: 60rpx 60rpx;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.24);
