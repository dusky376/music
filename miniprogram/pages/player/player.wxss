/* —— 队列半屏面板 —— */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 30;
}

.sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 62%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 32rpx 18rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 700;
}

.sheet-close {
  color: #007aff;
  font-size: 27rpx;
  padding: 6rpx 10rpx;
}

.sheet-scroll {
  flex: 1;
  min-height: 0;
}

.sheet-row {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  opacity: 0.72;
}

.sheet-row-active {
  opacity: 1;
  background: rgba(0, 122, 255, 0.06);
}

.sheet-playing {
  color: #007aff;
  font-size: 30rpx;
  font-weight: 700;
  margin-right: 14rpx;
  flex: 0 0 auto;
}

.sheet-meta {
  flex: 1;
  min-width: 0;
}

.sheet-name {
  font-size: 28rpx;
  font-weight: 640;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sheet-artist {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a8a92;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.badge {
  margin-left: 10rpx;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  background: rgba(255, 160, 0, 0.14);
  color: #d97a00;
  font-size: 18rpx;
  font-weight: 600;
  vertical-align: middle;
}

/* 歌词：flex 吃掉封面与进度条之间的全部空档，内容仍是平滑滚动的窗口（渐隐 + 手滑翻看） */
.lyrics {
  position: relative;
  width: 100%;
  flex: 1 1 auto;   /* 吃掉封面与进度条之间的全部高度：多出来的面积就等于多显示几行歌词 */
  min-height: 280rpx;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.04);
}

.lyric-track {
  transition: transform 340ms cubic-bezier(0.22, 0.61, 0.36, 1);
  will-change: transform;
}

.lyric-track.dragging {
  transition: none; /* 手滑跟手，不插动画 */
}

.lyric-lead {
  /* 高度由 JS 按实测窗高动态下发（style 内联），保证任意行可居中 */
  flex: 0 0 auto;
}

.lyric {
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  color: rgba(29, 29, 31, 0.34);
  font-size: 30rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  padding: 0 32rpx;
  box-sizing: border-box;
  transition: color 300ms ease, font-size 300ms ease;
}

.lyric-active {
  color: #1d1d1f;
  font-weight: 720;
  font-size: 38rpx;
}

.lyric-empty {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a0a0a8;
  font-size: 26rpx;
}

.lyric-fade {
  position: absolute;
  left: 0;
  right: 0;
  height: 60rpx;
  pointer-events: none;
}

.lyric-fade-top {
  top: 0;
  background: linear-gradient(to bottom, #ffffff 12%, rgba(255, 255, 255, 0));
}

.lyric-fade-bottom {
  bottom: 0;
  background: linear-gradient(to top, #ffffff 12%, rgba(255, 255, 255, 0));
}
