.wrap {
  padding: 20rpx 24rpx 40rpx;
}

.chips {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.chip {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 14rpx;
  border-radius: 32rpx;
  background: rgba(0, 0, 0, 0.05);
  color: #5f5f66;
  font-size: 25rpx;
}

.chip-active {
  background: #1d1d1f;
  color: #ffffff;
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 6rpx 22rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
}

.list {
  padding: 8rpx 20rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.04);
}

.row:last-child {
  border-bottom: none;
}

.cover {
  width: 76rpx;
  height: 76rpx;
  border-radius: 12rpx;
  background: #ececf1;
  flex-shrink: 0;
}

.meta {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.artist {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #75757c;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dur {
  color: #75757c;
  font-size: 23rpx;
}
