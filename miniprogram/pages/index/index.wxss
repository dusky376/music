.wrap {
  padding: 20rpx 24rpx 200rpx; /* 底部留出迷你播放条高度，列表不被遮 */
}

/* 顶部账号状态行：头像 + 昵称/提示 */
.account-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  min-height: 44rpx;
}

.avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex: 0 0 auto;
}

.account-text {
  color: #8a8a92;
  font-size: 22rpx;
}

.chips {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.chip {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 14rpx;
  border-radius: 32rpx;
  background: rgba(0, 0, 0, 0.05);
  color: #5f5f66;
  font-size: 25rpx;
}

.chip-active {
  background: #1d1d1f;
  color: #ffffff;
}

/* 封面加载失败（网易 CDN 404）时的灰色占位 */
.cover-fallback {
  background: #ececef;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fallback-note {
  color: #b9b9c0;
  font-size: 30rpx;
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 6rpx 22rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
}

.list {
  padding: 8rpx 20rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.04);
}

.row:last-child {
  border-bottom: none;
}

.cover {
  width: 76rpx;
  height: 76rpx;
  border-radius: 12rpx;
  background: #ececf1;
  flex-shrink: 0;
}

.meta {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.artist {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #75757c;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dur {
  color: #75757c;
  font-size: 23rpx;
}

/* 迷你播放条：固定贴底，展示当前曲目 + 播放暂停 */
.now-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  padding: 14rpx 18rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.14);
}

.now-cover {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  margin-right: 16rpx;
  flex: 0 0 auto;
  background: #ececef;
}

.now-meta {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.now-name {
  font-size: 27rpx;
  font-weight: 640;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.now-artist {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #8a8a92;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.now-toggle {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: #1d1d1f;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 40rpx 40rpx;
  flex: 0 0 auto;
}

.now-toggle:active {
  opacity: 0.7;
}

.now-toggle.ic-play {
  background-image: url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZD0iTTggNXYxNGwxMS03eiIgZmlsbD0iI2ZmZmZmZiIvPjwvc3ZnPg==');
}

.now-toggle.ic-pause {
  background-image: url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZD0iTTYgMTloNFY1SDZ6bTgtMTR2MTRoNFY1eiIgZmlsbD0iI2ZmZmZmZiIvPjwvc3ZnPg==');
}
