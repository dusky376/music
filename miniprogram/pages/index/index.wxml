<view class="wrap">
  <view class="account-row">
    <image wx:if="{{account.avatar}}" class="avatar" src="{{account.avatar}}" mode="aspectFill" />
    <text class="account-text">{{account.logged ? account.nickname : '未登录 · 网页版扫码后这里多出每日推荐'}}</text>
  </view>
  <scroll-view class="chips" scroll-x enable-flex>
    <view
      wx:for="{{sections}}"
      wx:key="key"
      class="chip {{item.key === activeKey ? 'chip-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="switchSection"
    >{{item.title}}</view>
  </scroll-view>

  <view class="hero">
    <text class="hero-title">{{title}}</text>
    <button class="btn-pill" size="mini" bindtap="onPlayAll" disabled="{{!tracks.length}}">播放全部</button>
  </view>

  <view wx:if="{{loading}}" class="empty">正在加载…</view>
  <view wx:elif="{{error}}" class="empty">{{error}}</view>
  <view wx:elif="{{!tracks.length}}" class="empty">这里暂时没有歌曲</view>

  <view wx:else class="card list">
    <view
      wx:for="{{tracks}}"
      wx:key="id"
      class="row"
      data-index="{{index}}"
      bindtap="onPlayRow"
    >
      <image
        wx:if="{{!item.coverBroken}}"
        class="cover"
        src="{{item.cover}}"
        mode="aspectFill"
        lazy-load
        binderror="onCoverError"
        data-index="{{index}}"
      />
      <view wx:else class="cover cover-fallback"><text class="fallback-note">♪</text></view>
      <view class="meta">
        <view class="name">{{item.name}}<text wx:if="{{item.vip}}" class="badge">VIP</text></view>
        <view class="artist">{{item.artist}} · {{item.album}}</view>
      </view>
      <view class="dur">{{item.durText}}</view>
    </view>
  </view>

  <!-- 迷你播放条：有当前曲目时贴底常驻（列出封面/歌名 + 播放暂停 + 点击进播放页） -->
  <view wx:if="{{now}}" class="now-bar" bindtap="onOpenPlayer">
    <image class="now-cover" src="{{now.cover}}" mode="aspectFill" />
    <view class="now-meta">
      <view class="now-name">{{now.name}}</view>
      <view class="now-artist">{{now.artist}}</view>
    </view>
    <view
      class="now-toggle {{nowPlaying ? 'ic-pause' : 'ic-play'}}"
      catchtap="onToggleNow"
    ></view>
  </view>
</view>
